#usda 1.0
(
    doc = """MaterialX standard_surface with a constant base_color, for the
    HdAnari MaterialX backend gate. Renders solid green (specular disabled so
    the diffuse albedo is unambiguous). Render with --camera /World/Cam."""
    upAxis = "Y"
    defaultPrim = "World"
)

def Xform "World"
{
    def Camera "Cam"
    {
        double3 xformOp:translate = (0, 0, 4)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def DomeLight "Dome"
    {
        float inputs:intensity = 1.0
    }

    def Mesh "Card" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        point3f[] points = [(-1, -1, 0), (1, -1, 0), (1, 1, 0), (-1, 1, 0)]
        texCoord2f[] primvars:st = [(0, 0), (1, 0), (1, 1), (0, 1)] (
            interpolation = "vertex"
        )
        rel material:binding = </World/Materials/MtlxMat>
    }

    def Scope "Materials"
    {
        def Material "MtlxMat"
        {
            token outputs:mtlx:surface.connect = </World/Materials/MtlxMat/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "ND_standard_surface_surfaceshader"
                color3f inputs:base_color = (0, 1, 0)
                float inputs:base = 1
                float inputs:specular = 0
                token outputs:surface
            }
        }
    }
}
