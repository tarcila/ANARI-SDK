source_up

# Repo root (directory containing this .envrc), so paths are machine-independent.
REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"

# Paths to the locally-built/installed project.
export PATH="${REPO_ROOT}/_out/bin${PATH:+:${PATH}}"
export LD_LIBRARY_PATH="${REPO_ROOT}/_out/lib${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"
export DYLD_LIBRARY_PATH="${REPO_ROOT}/_out/lib${DYLD_LIBRARY_PATH:+:${DYLD_LIBRARY_PATH}}"

# Expose our USD plugins.
export LD_LIBRARY_PATH="${REPO_ROOT}/_out/lib/usd/plugins${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"
export PXR_PLUGINPATH_NAME="${REPO_ROOT}/_out/lib/usd/plugins${PXR_PLUGINPATH_NAME:+:${PXR_PLUGINPATH_NAME}}"

# Machine-local overrides (external lib paths, secrets, ...). Untracked; see .env.
dotenv_if_exists
